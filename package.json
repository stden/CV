{
  "name": "stden-cv",
  "version": "2.0.0",
  "private": true,
  "description": "Denis Stepulenok's CV: a static engineering portfolio, targeted CV pages and PDF versions, generated from content/*.json.",
  "type": "module",
  "license": "ISC",
  "author": "Denis Stepulenok",
  "homepage": "https://stden.github.io/CV/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stden/CV.git"
  },
  "bugs": {
    "url": "https://github.com/stden/CV/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:html": "node scripts/build.mjs --no-pdf",
    "serve": "node scripts/serve.mjs",
    "test:unit": "node --test \"tests/**/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e",
    "check": "git diff --check"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@playwright/test": "1.65.1",
    "playwright": "1.65.1"
  }
}
